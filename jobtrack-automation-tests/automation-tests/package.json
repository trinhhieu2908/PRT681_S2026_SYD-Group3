{
  "name": "jobtrack-automation-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Automated API and end-to-end UI tests for the JobTrack web application (PRT681 Group 3)",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
